# Xorg session. Selected by install -x, the default when -w and -h are absent.

xorg                            # Display server
xinit                           # Startup scripts for Xorg
compton                         # Modern compositor for Xorg
xclip                           # Clipboard manager
xwallpaper                      # Sets up wallpapers
maim                            # Screen capture
arandr                          # Monitor configuration
ueberzug                        # Image preview
