set -e

# GRUB reads its background before an encrypted root is unlocked, so it gets a copy in /boot.
case "$1" in
configure)
	if [ -d /boot/grub ]; then
		cp -f /usr/share/images/dreamweaver/grub.jpg /boot/grub/dreamweaver.jpg
	fi
	;;
*) ;;
esac
