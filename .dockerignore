# Images. A netinst ISO in the build context would cost more than the repack, so
# iso.Dockerfile keeps base images in a cache mount instead.
*.iso
*.iso.asc
*.iso.sign

# Rebuilt in the container by scripts/make-tar.sh, so the host's copy is only noise.
dreamweaver.tar.gz
dreamweaver.tar.gz.asc

# Boot test leftovers
*.qcow2
*.vars.fd
*.ppm

.env
.env.local

# VCS, editor and scratch state
.git/
.gitignore
.idea/
scratch/
