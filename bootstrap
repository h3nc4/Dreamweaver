# The only part of the installation that runs as root, because a fresh netinst gives
# ./install nothing to escalate with. Everything after this goes through as_root.
#
# ./install invokes it when it cannot escalate. The ISO's late_command calls it directly,
# before dropping to the user.

set -e

[ "$(id -u)" -eq 0 ] || {
	echo "run this as root" >&2
	exit 1
}

export DEBIAN_FRONTEND=noninteractive

# debian-installer leaves a "deb cdrom:" line pointing at the install medium. Once that
# medium is gone apt-get update exits 100 (measured: 0 without the line), which killed
# every image install with nothing but "late_command failed with exit code 100".
#
# Done here rather than by preseeding apt-setup, whose debconf key had no effect.
# install.d/010-apt-sources replaces the file wholesale later.
if [ -f /etc/apt/sources.list ]; then
	sed -i -e '/^deb cdrom:/d' -e '/^deb-src cdrom:/d' /etc/apt/sources.list
fi

apt-get update -qq || {
	echo "apt-get update failed; check /etc/apt/sources.list" >&2
	exit 1
}
apt-get install -y --no-install-recommends locales opendoas ||
	{
		echo "could not install locales and opendoas" >&2
		exit 1
	}

# A netinst with no locale selected leaves this unset, and every later apt call complains.
if [ -z "${LC_ALL}" ] && ! locale -a 2>/dev/null | grep -qi '^en_US\.utf-\?8$'; then
	sed -i '/^# *en_US.UTF-8 UTF-8/s/^# *//' /etc/locale.gen
	locale-gen en_US.UTF-8
	update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
fi

# Passed by ./install. uid 1000 covers the ISO path, where the installer just made it.
OGUSER="${OGUSER:-$(id -nu 1000)}"
id -u "${OGUSER}" >/dev/null 2>&1 || {
	echo "no such user: ${OGUSER}" >&2
	exit 1
}

printf 'permit nopass nolog keepenv %s as root\n' "${OGUSER}" >/etc/doas.conf
chown 0:0 /etc/doas.conf
chmod 400 /etc/doas.conf

echo "root phase complete for ${OGUSER}"
