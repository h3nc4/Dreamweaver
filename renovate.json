{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "reviewers": [
    "h3nc4"
  ],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "The dev container pin belongs to CI, not to Renovate.",
      "matchManagers": ["devcontainer"],
      "enabled": false
    },
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "addLabels": ["automerge"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "A new Debian base for the dev image is a deliberate choice, not a bump",
      "matchPackageNames": [
        "debian"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Majors never automerge, so rebase them only on a conflict rather than rerunning CI each time main moves",
      "matchUpdateTypes": ["major"],
      "rebaseWhen": "conflicted"
    }
  ]
}
