#!/bin/sh
# shellcheck disable=SC2154 # DW_* and AUTOMATED come from lib/common and the environment
#
# Copyright (C) 2022-2026  Henrique Almeida <me@h3nc4.com>
#
# This file is part of Dreamweaver.
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

# Run as your regular user on a fresh Debian or Devuan netinst, selecting no packages.
#
# This only decides what runs. The work is in install.d, one numbered module per concern,
# each runnable alone:
#
#   ./install --list
#   ./install --only 070-packages
#   ./install --from 120-grub
#   DW_DEV=1 ./install.d/200-dev-extras
#
# Running a module twice equals running it once, which is what makes re-running this after
# an upgrade defined rather than a gamble.

set -e

cd "$(dirname "$0")"
# shellcheck source=lib/common
. ./lib/common

ONLY=''
FROM=''
SKIP=''
LIST=''
DRY=''

usage() {
	cat >&2 <<-EOF
		Usage: $0 [-o] [-d] [-g] [-v] [-h] [-x] [-w] [-m <mirror>]
		          [--list] [--dry-run] [--only <module>] [--from <module>] [--skip <module>]

		  -o             Include extra software
		  -d             Include development software
		  -g             Include gaming software
		  -v             Include virtualization software
		  -h             Headless only (disables -x and -w)
		  -x             Include Xorg (the default when neither -w nor -h is given)
		  -w             Include Wayland
		  -m <mirror>    Use this apt mirror

		  --list         Show the modules in run order and exit
		  --dry-run      Show what would run without running it
		  --only <m>     Run just this module; repeatable
		  --from <m>     Start at this module and run the rest
		  --skip <m>     Do not run this module; repeatable

		A module argument may be the full name or a unique prefix, so --only 070 works.
	EOF
	exit 1
}

# Long options first, leaving the single-letter set to getopts.
ARGS=''
while [ "$#" -gt 0 ]; do
	case "$1" in
	--list) LIST=y ;;
	--dry-run) DRY=y ;;
	--only)
		[ -n "$2" ] || usage
		ONLY="${ONLY} $2"
		shift
		;;
	--from)
		[ -n "$2" ] || usage
		FROM="$2"
		shift
		;;
	--skip)
		[ -n "$2" ] || usage
		SKIP="${SKIP} $2"
		shift
		;;
	--help) usage ;;
	--*) usage ;;
	*) ARGS="${ARGS} $1" ;;
	esac
	shift
done
# shellcheck disable=SC2086
set -- ${ARGS}

OPTIND=1
while getopts 'odgvhxwm:' opt; do
	case "${opt}" in
	o) DW_OPT=1 ;;
	d) DW_DEV=1 ;;
	g) DW_GAMES=1 ;;
	v) DW_VIRT=1 ;;
	h) DW_HEADLESS=1 ;;
	x) DW_XORG=1 ;;
	w) DW_WAYLAND=1 ;;
	m) DW_MIRROR="${OPTARG}" ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

if enabled "${DW_HEADLESS}" && { enabled "${DW_XORG}" || enabled "${DW_WAYLAND}"; }; then
	warn '-h overrides -x and -w; the graphical options are ignored'
fi

if enabled "${DW_HEADLESS}"; then
	DW_XORG=''
	DW_WAYLAND=''
	DW_GUI=''
else
	enabled "${DW_WAYLAND}" || DW_XORG=1
	DW_GUI=1
fi

export DW_OPT DW_DEV DW_GAMES DW_VIRT DW_XORG DW_WAYLAND DW_HEADLESS DW_GUI DW_MIRROR

################################################################################
# Module selection

# resolve_into <selectors>: each selector to exactly one module name, into RESOLVED.
# Up front, not in the loop below: a die inside a command substitution ends only that
# subshell, so a bad selector would surface as "no modules selected".
RESOLVED=''
resolve_into() {
	RESOLVED=''
	for _sel in $1; do
		set -- install.d/"${_sel}"*
		[ -f "$1" ] || die "no such module: ${_sel}"
		if [ "$#" -ne 1 ]; then
			_names=''
			for _m in "$@"; do
				_names="${_names} $(basename "${_m}")"
			done
			die "ambiguous module '${_sel}', matches:${_names}"
		fi
		RESOLVED="${RESOLVED} $(basename "$1")"
	done
}

# in_list <needle> <haystack of resolved names>
in_list() {
	for _i in $2; do
		[ "${_i}" = "$1" ] && return 0
	done
	return 1
}

MODULES=''
for m in install.d/*; do
	[ -f "${m}" ] || continue
	MODULES="${MODULES} $(basename "${m}")"
done
[ -n "${MODULES}" ] || die 'install.d is empty'

if [ -n "${ONLY}" ]; then
	resolve_into "${ONLY}"
	ONLY="${RESOLVED}"
fi
if [ -n "${SKIP}" ]; then
	resolve_into "${SKIP}"
	SKIP="${RESOLVED}"
fi
if [ -n "${FROM}" ]; then
	resolve_into "${FROM}"
	FROM="${RESOLVED# }"
fi

SELECTED=''
started=''

for m in ${MODULES}; do
	if [ -n "${ONLY}" ]; then
		in_list "${m}" "${ONLY}" || continue
	fi
	if [ -n "${FROM}" ] && [ -z "${started}" ]; then
		[ "${m}" = "${FROM}" ] || continue
		started=y
	fi
	if [ -n "${SKIP}" ] && in_list "${m}" "${SKIP}"; then
		continue
	fi
	SELECTED="${SELECTED} ${m}"
done

[ -n "${SELECTED}" ] || die 'no modules selected'

if [ -n "${LIST}" ]; then
	for m in ${MODULES}; do
		if in_list "${m}" "${SELECTED}"; then
			printf '  %s\n' "${m}"
		else
			printf '  %s (not selected)\n' "${m}"
		fi
	done
	exit 0
fi

################################################################################
# Run
#
# The root phase installs doas, so it precedes any as_root call. AUTOMATED=y means the
# ISO's late_command already ran it.

if [ "${AUTOMATED}" != 'y' ] && [ -z "${DRY}" ] && ! as_root true 2>/dev/null; then
	log 'running the root phase'
	if command -v sudo >/dev/null 2>&1; then
		sudo OGUSER="${DW_USER}" ./bootstrap
	else
		su -c "OGUSER=${DW_USER} ./bootstrap"
	fi || die 'the root phase failed'
fi

for m in ${SELECTED}; do
	printf '\n'
	log "${m}"
	if [ -n "${DRY}" ]; then
		printf '    would run install.d/%s\n' "${m}"
		continue
	fi
	"./install.d/${m}" || die "${m} failed"
done

printf '\n'
log 'installation successful'
