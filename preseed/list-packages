# Prints the installed packages to the console for test-install.sh. Inline in late_command,
# the same commands failed the finish step with no output.

list=/target/root/dreamweaver-packages.txt

# The format `scripts/package-sources.sh -q` prints, which scripts/test-release.sh checks.
# shellcheck disable=SC2016
chroot /target dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version} ${source:Package} ${source:Version} ${Homepage}\n' |
	grep '^ii' >"${list}"

# late-command deletes the target's copy of the profile, so it is exported again from debconf.
/profile-select --export /tmp/dw-packages.profile || :

{
	echo DREAMWEAVER-PACKAGES-BEGIN
	cat /tmp/dw-packages.profile "${list}"
	echo "DREAMWEAVER-PACKAGES-END $(wc -l <"${list}")"
} >/dev/console

exit 0
